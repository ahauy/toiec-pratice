# ---- Free providers (set at least one; both = automatic fallback) -------------------
# Groq (free, no card): https://console.groq.com/keys  -> Whisper STT + gpt-oss LLM
GROQ_API_KEY=
# Google AI Studio (free tier): https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# ---- Optional tuning ------------------------------------------------------------------
# Comma-separated "provider:model", tried in order. Providers without a key are skipped;
# a model that answers 429 is skipped for a while, then retried.
# STT_CHAIN=gemini:gemini-2.0-flash-lite
# LLM_CHAIN=gemini:gemini-2.0-flash-lite,groq:openai/gpt-oss-120b,groq:openai/gpt-oss-20b

# Optional shared secret; if set, the frontend must send the same value (VITE_APP_TOKEN).
# APP_TOKEN=
# Optional comma-separated list of allowed frontend origins (default: any).
# ALLOWED_ORIGINS=https://your-app.vercel.app

PORT=3000
